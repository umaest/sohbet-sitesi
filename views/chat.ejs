        </header>
        <div id="message">
            <div id="ustkısım2">
                <text><%=room%></text>
            </div>
            <div id="msgbox">
            </div>
            <div id="write">
                <textarea maxlength="2000" type="text" translate="no" id="msg" placeholder="Message"></textarea>
                <button id="send" onclick="sendMsg()">></button>
            </div>
        </div>
        <div class="contain">
            <i class="menu fa-solid fa-bars"></i>
            <div id="users">
            
            <div id="ustkısım">
                <text>Users</text>
                <button onclick="settings(true)" id="settingsB" class="fa-solid fa-gear"></button>
            </div>
            </div>
        </div>
        
