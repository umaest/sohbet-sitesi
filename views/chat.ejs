        <script>
            let room = "<%=room%>"
            let username = "<%=name%>"
            const publicVapidKey = "<%=vapidkey%>";
            const getRoomName = () => {
			let roomName = location.pathname.substring(1);
			
			return roomName;
		}
		var signaling_socket = null;
		var USE_AUDIO = true;
		var USE_VIDEO = false;
		var ROOM_ID = getRoomName();
        var DEFAULT_CHANNEL = room
        let idSearch = {}
        function showAlert(msg) {
            var alertBox = document.createElement('div');
            alertBox.classList.add('alertt');
            alertBox.innerHTML = `<img src="https://pngimg.com/d/attention_PNG61.png"><p class="AlertText">${msg}</p>`;
            document.body.appendChild(alertBox);
            setTimeout(()=>{
            alertBox.style.animation = "shake 0.8s ease-in-out"
            setTimeout(function() {
                alertBox.style.animation = 'slideOut 0.8s forwards';
                setTimeout(function() {
                    alertBox.parentNode.removeChild(alertBox);
                }, 600);
            }, 4000);},550)
}
