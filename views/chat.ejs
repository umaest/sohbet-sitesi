    <body onload="init()"> 
        <audio id="remote-audio" style="visibility: hidden;"></audio>
        <header class="header">
            <div id="settings">
                <div style="display: flex;">
                    <div class="ayarlar-text">Ayarlar</div>
                    <button class="fa-solid fa-x exit-btn" onclick="settings(false)"></button>
                </div>
                <div class="form-check form-switch" >
                    <label class="form-check-label" for="flexSwitchCheckDefault">Default switch checkbox input</label>
                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                </div>
                <button class="fa fa-bell bildirim" onclick="openNot()"></button>
                <button onclick="exit()" class="çıkış">ÇIKIŞ</button>  
