            </div>
            <button onclick="settings(true)" id="settingsB" class="fa-solid fa-gear"></button>
            </div>
        </div>
        <div class="clients"></div>
        <script src="./scripts/voicechat.js"></script>
        <script src="./scripts/chat.js"></script>
